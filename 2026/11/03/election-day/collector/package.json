{
  "name": "herald-election-results-collector",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "wrangler deploy --dry-run --outdir .build",
    "check:health": "wrangler deploy --config wrangler.health.jsonc --dry-run --outdir .build/health",
    "check:source": "node scripts/check-source.mjs",
    "admin": "node scripts/admin.mjs",
    "dev": "wrangler dev",
    "build:delivery": "node scripts/build-delivery.mjs",
    "test:delivery": "node --test tests/delivery.test.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261103.1",
    "esbuild": "0.28.2",
    "miniflare": "5.20261103.0-beta",
    "wrangler": "4.157.0"
  }
}
